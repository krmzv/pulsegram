# ── Required ──────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Optional ──────────────────────────────────────────────
# Public URL used in dashboard/status links shown by the bot
BASE_URL=http://localhost:3000
PORT=3000

# SQLite file path (default) OR a postgres:// connection string
DATABASE_URL=./data/pulsegram.db

# true → no monitor limits, no billing, no upgrade prompts (you own the instance)
SELF_HOSTED=false

# Auto-generated and persisted to ./data on first run if left empty
BETTER_AUTH_SECRET=

# Shared secret between api and probe. Auto-generated if empty; set explicitly
# in compose deployments so probe and api share the same value.
INTERNAL_SECRET=

# Set to false in compose deployments where the Go probe handles all checks.
# Defaults to true so `bun run dev` works without the probe.
SCHEDULER_ENABLED=true

# Set to false on the api service in compose (bot service handles polling).
# Defaults to true so `bun run dev` runs the full monolith.
BOT_POLLING=true

# Required in compose deployments. Used for the db service and DATABASE_URL default.
DB_PASSWORD=

# SSRF safety valve. Keep false. Only set true if you intentionally
# want to monitor private/internal addresses on a trusted network.
ALLOW_PRIVATE_TARGETS=false
