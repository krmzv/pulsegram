# ── Required ──────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Optional ──────────────────────────────────────────────
# Public URL used in dashboard/status links shown by the bot
BASE_URL=http://localhost:3000
PORT=3000

# SQLite file path (default) OR a postgres:// connection string
DATABASE_URL=./data/pulsegram.db

# true → no monitor limits, no billing, no upgrade prompts (you own the instance)
SELF_HOSTED=false

# Auto-generated and persisted to ./data on first run if left empty
BETTER_AUTH_SECRET=

# SSRF safety valve. Keep false. Only set true if you intentionally
# want to monitor private/internal addresses on a trusted network.
ALLOW_PRIVATE_TARGETS=false
